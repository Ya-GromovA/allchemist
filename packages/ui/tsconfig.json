{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "baseUrl": ".",
    "paths": {
      "@allchemist/design-tokens": ["../design-tokens/src"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
