* text=auto eol=lf

# Windows-native command files retain their platform line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary and packaged assets must never receive text conversion.
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.webp -text
*.ico -text
*.woff -text
*.woff2 -text
*.ttf -text
*.pdf -text
*.docx -text
*.zip -text
*.gz -text
*.tar -text
*.apk -text
*.aab -text
