# ALC-004B1 repository template. Do not enable this file directly.
# Render every placeholder token into a protected temporary file, validate it,
# and install it only under an explicitly authorized ALC-004B2 change.
# No fallback to any other upstream is permitted by this configuration.

server {
    listen 80;
    listen [::]:80;
    server_name preview.allchemist.ru;
    server_tokens off;

    access_log /var/log/nginx/preview.allchemist.ru.access.log combined;
    error_log /var/log/nginx/preview.allchemist.ru.error.log warn;

    # Required for initial issuance and unattended HTTP-01 renewal.
    location ^~ /.well-known/acme-challenge/ {
        auth_basic off;
        root @@ACME_WEBROOT@@;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name preview.allchemist.ru;
    server_tokens off;

    access_log /var/log/nginx/preview.allchemist.ru.access.log combined;
    error_log /var/log/nginx/preview.allchemist.ru.error.log warn;

    ssl_certificate @@CERTIFICATE_FULLCHAIN@@;
    ssl_certificate_key @@CERTIFICATE_PRIVATE_KEY@@;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    auth_basic "Allchemist Preview";
    auth_basic_user_file @@BASIC_AUTH_FILE@@;

    proxy_hide_header X-Powered-By;
    proxy_hide_header X-Nextjs-Cache;
    proxy_hide_header X-Nextjs-Prerender;
    proxy_hide_header X-Nextjs-Stale-Time;
    client_max_body_size 20m;
    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    send_timeout 60s;

    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=86400" always;

    # Public robots policy contains no application data and must be readable by crawlers.
    location = /robots.txt {
        auth_basic off;
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    # Protected operator health endpoint. It proxies only to the canonical 3011 runtime.
    location = /__preview_health {
        proxy_pass http://127.0.0.1:3011/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        add_header Cache-Control "no-store" always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }

    location ^~ /_next/static/ {
        proxy_pass http://127.0.0.1:3011;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # No fallback to any other upstream is permitted.
    location / {
        proxy_pass http://127.0.0.1:3011;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering on;
    }
}
