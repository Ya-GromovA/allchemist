# Template for infra/db.env -- the SINGLE SOURCE OF TRUTH for the database
# connection parameters. The real file carries the production password and is
# therefore gitignored; this template is the versioned contract.
#
# Create it on a new host with:
#   cp infra/db.env.example infra/db.env && chmod 600 infra/db.env
# then fill in the values. Consumers:
#   * infra/docker-compose.yml       -- `env_file: ./db.env` for both services;
#     the backend service overrides POSTGRES_HOST/POSTGRES_PORT with the
#     in-container network location (synapse-db:5432).
#   * backend/app/core/config.py     -- loaded after backend/.env, so it wins.
#   * tools/db/alembic_prod.sh and the rest of tools/db.
#
# The values are the HOST view: synapse-db publishes 5432 on the host as
# 127.0.0.1:5433. Do not duplicate these keys into infra/.env or backend/.env;
# tools/stage15-production-hardening-check.sh fails the build if you do.

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=synapse
POSTGRES_PASSWORD=
POSTGRES_DB=synapse
